generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// CATÁLOGOS GEOGRÁFICOS (jerárquicos)
// ==========================================

model Pais {
  id                 String       @id @default(uuid())
  nombre             String       @unique
  estados            Estado[]

  personas           Persona[]
  estudiantesNacidos Estudiante[] @relation("PaisNacimiento")
}

model Estado {
  id                 String       @id @default(uuid())
  nombre             String
  pais               Pais         @relation(fields: [paisId], references: [id])
  paisId             String
  municipios         Municipio[]

  personas           Persona[]
  estudiantesNacidos Estudiante[] @relation("EstadoNacimiento")
}

model Municipio {
  id                 String       @id @default(uuid())
  nombre             String
  estado             Estado       @relation(fields: [estadoId], references: [id])
  estadoId           String
  parroquias         Parroquia[]

  personas           Persona[]
  estudiantesNacidos Estudiante[] @relation("MunicipioNacimiento")
}

model Parroquia {
  id                 String       @id @default(uuid())
  nombre             String
  municipio          Municipio    @relation(fields: [municipioId], references: [id])
  municipioId        String

  personas           Persona[]
  estudiantesNacidos Estudiante[] @relation("ParroquiaNacimiento")
}

// ==========================================
// AUTENTICACIÓN Y ROLES (RBAC)
// ==========================================

model Usuario {
  id               String             @id @default(uuid())
  persona          Persona?           @relation(fields: [personaId], references: [id])
  personaId        String?            @unique
  email            String             @unique
  password         String
  activo           Boolean            @default(true)
  emailVerificado  Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  roles            UsuarioRol[]
  solicitudes      SolicitudIngreso[]
  tokens           TokenAcceso[]
  universidades    UsuarioUniversidad[]
}

model Rol {
  id          String             @id @default(uuid())
  nombre      String             @unique
  descripcion String?

  usuarios    UsuarioRol[]
  permisos    RolModuloPermiso[]
}

model UsuarioRol {
  id            String       @id @default(uuid())
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])
  usuarioId     String
  rol           Rol          @relation(fields: [rolId], references: [id])
  rolId         String
  universidad   Universidad? @relation(fields: [universidadId], references: [id])
  universidadId String?
  fechaInicio   DateTime     @default(now())
  fechaFin      DateTime?

  @@unique([usuarioId, rolId, universidadId])
}

model Modulo {
  id       String             @id @default(uuid())
  nombre   String             @unique
  slug     String             @unique
  permisos RolModuloPermiso[]
}

model RolModuloPermiso {
  id              String  @id @default(uuid())
  rol             Rol     @relation(fields: [rolId], references: [id])
  rolId           String
  modulo          Modulo  @relation(fields: [moduloId], references: [id])
  moduloId        String
  puedeCrear      Boolean @default(false)
  puedeLeer       Boolean @default(false)
  puedeActualizar Boolean @default(false)
  puedeEliminar   Boolean @default(false)

  @@unique([rolId, moduloId])
}

enum TipoToken {
  RESET_PASSWORD
  VERIFICACION_EMAIL
}

model TokenAcceso {
  id        String    @id @default(uuid())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId String
  token     String    @unique
  tipo      TipoToken
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ==========================================
// PERSONA (base compartida entre Estudiante y Docente)
// ==========================================

enum Genero {
  MASCULINO
  FEMENINO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  DIVORCIADO
  VIUDO
  UNION_LIBRE
}

enum TipoVivienda {
  RESIDENCIADO
  VIVIENDA_PROPIA
}

model Persona {
  id              String       @id @default(uuid())
  cedula          String       @unique
  nacionalidad    String
  nombres         String
  apellidos       String
  genero          Genero
  estadoCivil     EstadoCivil
  fechaNacimiento DateTime
  telefono        String
  correo          String

  pais            Pais         @relation(fields: [paisId], references: [id])
  paisId          String
  estado          Estado       @relation(fields: [estadoId], references: [id])
  estadoId        String
  municipio       Municipio    @relation(fields: [municipioId], references: [id])
  municipioId     String
  parroquia       Parroquia    @relation(fields: [parroquiaId], references: [id])
  parroquiaId     String
  localidad       String?
  calle           String?
  numeroCasa      String?
  puntoReferencia String?
  tipoVivienda    TipoVivienda

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  usuario         Usuario?
  estudiantes     Estudiante[]
}

// ==========================================
// ESTUDIANTES
// ==========================================

model CondicionMatricular {
  id          String                @id @default(uuid())
  nombre      String                @unique
  descripcion String?

  estudiantes EstudianteCondicion[]
}

model EstudianteCondicion {
  id           String              @id @default(uuid())
  estudiante   Estudiante          @relation(fields: [estudianteId], references: [id])
  estudianteId String
  condicion    CondicionMatricular @relation(fields: [condicionId], references: [id])
  condicionId  String
  fechaInicio  DateTime            @default(now())
  fechaFin     DateTime?
}

model TipoIngreso {
  id            String             @id @default(uuid())
  universidad   Universidad        @relation(fields: [universidadId], references: [id])
  universidadId String
  nombre        String
  descripcion   String?

  estudiantes   Estudiante[]
  solicitudes   SolicitudIngreso[]

  @@unique([universidadId, nombre])
}

model Estudiante {
  id                    String                @id @default(uuid())
  persona               Persona               @relation(fields: [personaId], references: [id])
  personaId             String
  universidad           Universidad           @relation(fields: [universidadId], references: [id])
  universidadId         String
  tipoIngreso           TipoIngreso           @relation(fields: [tipoIngresoId], references: [id])
  tipoIngresoId         String

  grupoEtnico           String?
  paisNacimiento        Pais?                 @relation("PaisNacimiento", fields: [paisNacimientoId], references: [id])
  paisNacimientoId      String?
  estadoNacimiento      Estado?               @relation("EstadoNacimiento", fields: [estadoNacimientoId], references: [id])
  estadoNacimientoId    String?
  municipioNacimiento   Municipio?            @relation("MunicipioNacimiento", fields: [municipioNacimientoId], references: [id])
  municipioNacimientoId String?
  parroquiaNacimiento   Parroquia?            @relation("ParroquiaNacimiento", fields: [parroquiaNacimientoId], references: [id])
  parroquiaNacimientoId String?

  expedienteCompleto        Boolean   @default(true)
  excepcionAutorizadaPorId  String?
  excepcionMotivo           String?
  excepcionFecha            DateTime?

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  condiciones           EstudianteCondicion[]
  solicitudes           SolicitudIngreso[]

  @@unique([personaId, universidadId])
}

// ==========================================
// NIVELES ACADÉMICOS Y PROGRAMAS
// ==========================================

model NivelAcademico {
  id                   String              @id @default(uuid())
  nombre               String              @unique
  descripcion          String?
  requiereExclusividad Boolean             @default(false)

  programas            ProgramaFormacion[]
}

model ProgramaFormacion {
  id               String             @id @default(uuid())
  codigo           String
  nombre           String
  descripcion      String?
  activo           Boolean            @default(true)

  nivelAcademico   NivelAcademico     @relation(fields: [nivelAcademicoId], references: [id])
  nivelAcademicoId String

  universidad      Universidad        @relation(fields: [universidadId], references: [id])
  universidadId    String

  solicitudes      SolicitudIngreso[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([universidadId, codigo])
}

// ==========================================
// PROCESO DE INGRESO (ASPIRANTES)
// ==========================================

model ConvocatoriaIngreso {
  id            String             @id @default(uuid())
  universidad   Universidad        @relation(fields: [universidadId], references: [id])
  universidadId String
  nombre        String
  fechaInicio   DateTime
  fechaFin      DateTime
  activa        Boolean            @default(true)

  solicitudes   SolicitudIngreso[]

  @@unique([universidadId, nombre])
}

model OrigenIngreso {
  id            String             @id @default(uuid())
  universidad   Universidad        @relation(fields: [universidadId], references: [id])
  universidadId String
  nombre        String
  descripcion   String?

  solicitudes   SolicitudIngreso[]

  @@unique([universidadId, nombre])
}

enum EstadoSolicitud {
  PENDIENTE
  EN_REVISION
  CONFIRMADA
  RECHAZADA
  ANULADA
}

model SolicitudIngreso {
  id                 String              @id @default(uuid())
  usuario            Usuario             @relation(fields: [usuarioId], references: [id])
  usuarioId          String
  convocatoria       ConvocatoriaIngreso @relation(fields: [convocatoriaId], references: [id])
  convocatoriaId     String
  origen             OrigenIngreso       @relation(fields: [origenId], references: [id])
  origenId           String
  tipoIngreso        TipoIngreso         @relation(fields: [tipoIngresoId], references: [id])
  tipoIngresoId      String

  especialidad       ProgramaFormacion   @relation(fields: [especialidadId], references: [id])
  especialidadId     String
  estado             EstadoSolicitud     @default(PENDIENTE)

  estudiante         Estudiante?         @relation(fields: [estudianteId], references: [id])
  estudianteId       String?
  observacionGeneral String?
  documentos         SolicitudDocumento[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Universidad {
  id          String   @id @default(uuid())
  nombre      String   @unique
  siglas      String
  ubicacion   String?
  telefono    String?
  correo      String?

  programas       ProgramaFormacion[]
  usuarios        UsuarioUniversidad[]
  rolesAsignados  UsuarioRol[]
  tiposDocumento  TipoDocumento[]
  convocatorias   ConvocatoriaIngreso[]
  origenesIngreso OrigenIngreso[]
  tiposIngreso    TipoIngreso[]
  estudiantes     Estudiante[]
  permiteExcepcionExpedienteIncompleto Boolean @default(true)
  entradas         Entrada[]
  lapsosAcademicos LapsoAcademico[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UsuarioUniversidad {
  id            String      @id @default(uuid())
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String
  universidad   Universidad @relation(fields: [universidadId], references: [id], onDelete: Cascade)
  universidadId String

  @@unique([usuarioId, universidadId])
}

// ==========================================
// DOCUMENTOS DEL EXPEDIENTE (catálogo dinámico por universidad)
// ==========================================

model TipoDocumento {
  id            String      @id @default(uuid())
  universidad   Universidad @relation(fields: [universidadId], references: [id])
  universidadId String
  nombre        String
  descripcion   String?
  minImagenes   Int         @default(1)
  maxImagenes   Int?
  obligatorio   Boolean     @default(true)
  activo        Boolean     @default(true)
  orden         Int         @default(0)

  documentosSolicitud SolicitudDocumento[]

  @@unique([universidadId, nombre])
}

enum EstadoDocumento {
  PENDIENTE
  SUBIDO
  APROBADO
  RECHAZADO
}

model SolicitudDocumento {
  id              String           @id @default(uuid())
  solicitud       SolicitudIngreso @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  solicitudId     String
  tipoDocumento   TipoDocumento    @relation(fields: [tipoDocumentoId], references: [id])
  tipoDocumentoId String
  estado          EstadoDocumento  @default(PENDIENTE)
  observacion     String?
  revisadoPorId   String?
  revisadoEn      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  imagenes        DocumentoImagen[]

  @@unique([solicitudId, tipoDocumentoId])
}
model DocumentoImagen {
  id                   String             @id @default(uuid())
  solicitudDocumento   SolicitudDocumento @relation(fields: [solicitudDocumentoId], references: [id], onDelete: Cascade)
  solicitudDocumentoId String
  key                  String
  orden                Int                @default(1)
  createdAt            DateTime           @default(now())
}

// ==========================================
// LAPSOS ACADÉMICOS Y ENTRADAS (por universidad)
// ==========================================

model Entrada {
  id            String           @id @default(uuid())
  universidad   Universidad      @relation(fields: [universidadId], references: [id])
  universidadId String
  codigo        String
  descripcion   String?
  activo        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  lapsosAcademicos LapsoAcademico[]

  @@unique([universidadId, codigo])
}

enum TipoLapso {
  PREGRADO
  POSTGRADO
  INTENSIVO
  ESPECIAL
}

model LapsoAcademico {
  id            String      @id @default(uuid())
  universidad   Universidad @relation(fields: [universidadId], references: [id])
  universidadId String
  entrada       Entrada     @relation(fields: [entradaId], references: [id])
  entradaId     String
  codigo        String
  descripcion   String?
  fechaInicio   DateTime
  fechaFin      DateTime
  tipo          TipoLapso
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([universidadId, codigo])
}